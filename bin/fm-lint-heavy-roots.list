# Lint roots whose source-following ShellCheck analysis alone needs several GB.
# This is a record of measured heavy roots, not runtime input: bin/fm-lint.sh
# does not read it, because it already runs every canonical root in its own
# ShellCheck process. tests/fm-lint.test.sh test_heavy_roots_run_alone checks
# that each listed root is still a canonical lint root and still runs alone in
# exactly one invocation. Add a root when a single-file, memory-capped
# measurement shows it near 4 GB or more.
bin/fm-teardown.sh
bin/fm-procevent-remote-reply.sh
tests/fm-remote-reply.test.sh
bin/fm-pr-merge.sh
bin/fm-send.sh
tests/fm-pending-reply.test.sh
